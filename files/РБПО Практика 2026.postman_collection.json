          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"CSRF token received\", () => pm.response.status(200));\r\nif (pm.response.code === 200) {\r\n    pm.environment.set(\"csrfToken\", pm.response.json().token);\r\n} else {\r\n    pm.environment.unset(\"csrfToken\");\r\n}"
